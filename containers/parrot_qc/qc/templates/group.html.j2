<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Parrot QC — group</title>
<style>
  :root { --pass:#2e7d32; --warn:#ef6c00; --fail:#c62828; --skip:#9e9e9e; }
  body { font-family:-apple-system, Segoe UI, Roboto, sans-serif; margin:0; color:#222; background:#fafafa; }
  header { background:#263238; color:#fff; padding:16px 24px; }
  header h1 { margin:0; font-size:20px; }
  header .meta { font-size:13px; opacity:.8; margin-top:4px; }
  main { padding:20px 24px 60px; }
  .badge { display:inline-block; padding:2px 9px; border-radius:10px; color:#fff; font-size:12px; font-weight:600; text-transform:uppercase; }
  .pass{background:var(--pass)} .warn{background:var(--warn)} .fail{background:var(--fail)} .skip{background:var(--skip)}
  table { border-collapse:collapse; font-size:12px; background:#fff; }
  th, td { border:1px solid #e0e0e0; padding:5px 7px; text-align:center; white-space:nowrap; }
  th.stage { writing-mode:vertical-rl; transform:rotate(180deg); height:140px; font-weight:500; }
  td.sub { text-align:left; }
  td.sub a { text-decoration:none; color:#1565c0; font-weight:600; }
  .cell { width:14px; height:14px; border-radius:3px; display:inline-block; }
</style>
</head>
<body>
<header>
  <h1>Parrot reconstruction QC — group
      <span class="badge {{ overall }}">{{ overall }}</span></h1>
  <div class="meta">{{ subjects|length }} subject(s) · generated {{ generated }}</div>
</header>
<main>
  <table>
    <tr>
      <th class="sub" style="writing-mode:horizontal-tb">subject</th>
      <th style="writing-mode:horizontal-tb">overall</th>
      {% for st in stage_order %}<th class="stage">{{ stage_titles[st] }}</th>{% endfor %}
    </tr>
    {% for s in subjects %}
    <tr>
      <td class="sub"><a href="{{ s.href }}">{{ s.subject }}</a></td>
      <td><span class="badge {{ s.overall }}">{{ s.overall }}</span></td>
      {% for st in stage_order %}
        {% set status = s.stages.get(st, 'skip') %}
        <td title="{{ st }}: {{ status }}"><span class="cell {{ status }}"></span></td>
      {% endfor %}
    </tr>
    {% endfor %}
  </table>
</main>
</body>
</html>
