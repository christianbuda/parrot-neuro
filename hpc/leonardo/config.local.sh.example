# Personal LEONARDO config for Parrot -- COPY this to config.local.sh (gitignored) and fill in.
#
#   cp hpc/leonardo/config.local.sh.example hpc/leonardo/config.local.sh
#   # then edit ACCT / paths below
#
# It is sourced automatically by hpc/leonardo/{check_leonardo.sh, pilot.sbatch,
# prewarm_hippunfold.sh, prewarm_templateflow.sh} -- so you set your account and
# paths ONCE here instead of editing every script. An env var of the same name set
# at call time still wins (every line uses the ${VAR:-...} "only if unset" idiom).
#
# This is plain bash; keep it to variable assignments (no side effects).

# BILLING account only -- the --account / saldo value. NOT used to build any path.
ACCT="${ACCT:-<BILLING_ACCOUNT>}"                     # find it with: saldo -b
# STORAGE area -- INDEPENDENT of ACCT (you may bill one allocation but store in another
# account's work area). Set the actual path; it does NOT track $ACCT. ($WORK is ambiguous
# with multiple accounts, so give it explicitly.)
WORKDIR="${WORKDIR:-/leonardo_work/<STORAGE_ACCOUNT>}"
REPO="${REPO:-$HOME/parrot-neuro}"                    # clone location of this repo
SUBJECT="${SUBJECT:-010002}"                          # default subject for the pilot / preflight

# Derived layout -- override only if yours differs:
BIDS="${BIDS:-$WORKDIR/parrot/bids}"                  # staged BIDS dataset on the cluster
OUTPUT_DIR="${OUTPUT_DIR:-$BIDS/derivatives}"         # derivatives (also where the prewarmed caches live)
SIF="${SIF:-$WORKDIR/parrot/parrot_sif}"              # .sif cache; prewarm_*.sh read this too (as SIF_DIR)

# --- cohort array (submit_cohort.sh) -- only override if the defaults are wrong -----
# The A1/A2/B/C/D chunk map + walltimes live IN submit_cohort.sh; these are just the
# knobs most likely to need site-specific tweaking.
# PARTICIPANTS="$BIDS/participants.tsv"               # array is generated from this
# SUBJ_FILE="$WORKDIR/parrot/cohort_subjects.txt"     # generated: array index -> subject label
# Partition / QoS names. dcgp (CPU, 112c, 512-node concurrency) is UNTESTED for this
# account -- if `sinfo` shows different names, set them here.
# BOOST_PART="boost_usr_prod" ; BOOST_QOS="normal"
# DCGP_PART="dcgp_usr_prod"   ; DCGP_QOS="normal"
# ARRAY_THROTTLE="%40"                                # cap concurrent array elements ("" = no cap)
# MAX_SUBMIT="1000"                                   # QOS submit cap (pending+running tasks/user);
#                                                     #   guards `run` from tripping it. Phase the DAG
#                                                     #   (run --chunks ...) when 5*N_subjects exceeds it.
