# parrot development
development/
eeg_bold_fit_res/
eeg_bold_fit_res_summary/
eeg_channel_qc_res/
# parrot specific
.temp_pipeline*

# cohort analyses (git-ignored: large caches + result artifacts, not shipped code)
analyses/

# --- Python Standard ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.env

# --- Distribution / Packaging ---
dist/
build/
*.egg-info/

# --- Jupyter Notebooks ---
# Ignore checkpoint folders created by Jupyter
.ipynb_checkpoints/

# --- IDEs and Editors ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Docker ---
# If you have local overrides for docker-compose
docker-compose.override.yml
# Local build logs or temp files
.docker/

# --- PROJECT SPECIFIC: DATA & OUTPUTS ---
# Critical: Do not upload large subject data or simulation results

# Ignore a generic data folder if you put raw subjects there
data/
raw_data/
subjects/

# Ignore simulation outputs/results
results/
outputs/
logs/

# Common Neuro/Science large file formats (just in case they aren't in data/)
# You don't want to accidentally push a 2GB MRI scan
*.nii
*.nii.gz
*.dcm
*.h5
*.hdf5
*.vtu
*.msh
*.dat
*.bin

# --- Temporary/Scratch ---
tmp/
temp/

# Local .sif build output (hpc/leonardo/build_sif_local.sh) + hippunfold cache — never commit
parrot_sif_local/
hippunfold_cache/

# HArtMuT template assets are fetched at first use (GPL-3.0, not vendored) — never commit.
# Only template_data/hartmut/{fetch_hartmut.py,README.md} are tracked; the cache is not.
.hartmut_cache/
template_data/hartmut/assets/
# pixi environments
.pixi/*
!.pixi/config.toml
templateflow_cache/
hpc/leonardo/config.local.sh

# W&B sweep operator state (submit_sweep.sh) -- run-specific, not portable across machines
hpc/leonardo/.sweep_id
hpc/leonardo/.sweep_agent_pids
hpc/leonardo/sweep_logs/
wandb/
